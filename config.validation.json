{
  "_comment": "Custom WAF Validation Targets Configuration",
  "_description": "Define your own test URLs with expected responses. The default target is Tata Power. Add more targets to the array if needed.",
  
  "custom_targets": [
    {
      "name": "Tata-Power-WAF",
      "url": "https://www.tatapower.com/",
      "vendor": "Indian-Enterprise",
      "expected_status": 200,
      "keywords": ["Tata", "Power"],
      "anti_keywords": ["captcha", "blocked", "access denied", "forbidden"],
      "min_content_length": 1000,
      "timeout": 5.0,
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.5"
      }
    }
  ],
  
  "validation_settings": {
    "required_consensus_rate": 0.6,
    "refresh_blacklist_interval_minutes": 60,
    "max_concurrent_validations": 10,
    "enable_soft_block_detection": true,
    "enable_keyword_validation": true,
    "min_vendor_coverage": 1
  },
  
  "blacklist_sources": [
    "https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset",
    "https://raw.githubusercontent.com/stamparm/ipsum/master/levels/2.txt"
  ],
  
  "built_in_targets_override": {
    "_comment": "Set to true to disable built-in targets and use ONLY custom targets",
    "enabled": false
  }
}
