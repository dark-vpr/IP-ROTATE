{
  "_comment": "ip-rotator v4.2.0 PRODUCTION config - OPTIMIZED FOR <1s RESPONSE TIMES",
  "listen_host": "0.0.0.0",
  "listen_port": 8000,
  "enable_socks": true,
  "socks_listen_host": "0.0.0.0",
  "socks_listen_port": 1080,

  "interval": 10.0,
  "rotate_every_request": false,
  "no_reuse_seconds": 1800,
  "policy_on_exhaustion": "strict",
  "allow_direct": false,
  "allow_plain_http": false,
  "starvation_wait": 15.0,
  "starvation_retry_delay": 0.2,
  "max_retries": 3,
  "connect_timeout": 8.0,

  "state_path": "/root/.ip_rotator/state.db",

  "enable_warp": true,
  "warp_accounts": 3,
  "wireproxy_bin": "/usr/local/bin/wireproxy",
  "warp_proxy_port": 40000,
  "wg_configs_dir": "/root/.ip_rotator/wg-configs",

  "enable_warpplus": false,
