  "singwarp_socks_base_port": 45000,
  "singwarp_handshake_grace": 15.0,
  "singwarp_probe_timeout": 15.0,

  "enable_v2ray": true,
  "v2ray_max_nodes": 300,
  "v2ray_socks_base_port": 43000,
  "v2ray_min_warm": 20,
  "v2ray_health_seconds": 25.0,
  "v2ray_sub_refresh_seconds": 120.0,
  "v2ray_probe_workers": 48,
  "v2ray_probe_timeout": 5.0,
  "v2ray_udp_ok": true,

  "enable_psiphon": false,
  "enable_vpngate": false,
  "enable_windscribe_proxy": false,

