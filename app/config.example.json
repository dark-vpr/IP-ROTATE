  "wg_reprobe_seconds": 300.0,
  "wg_lane_refresh_seconds": 30.0,
  "wg_lane_disable_after": 6,
  "warp_register_cooldown": 30.0,
  "warp_accounts_max": 64,
  "allow_direct": false,
  "webshare_api_key": "",
  "static_proxies": [],
  "api_keys": {
    "zenrows": "",
    "scrapingbee": "",
    "crawlbase": "",
    "scraperapi": ""
  },
  "fetch_priority": [
    "zenrows",
    "firecrawl",
    "scrapingbee",
    "crawlbase",
    "scraperapi"
  ],
  "state_path": "~/.ip_rotator/state.db",
  "fresh_ledger": false,
  "log_level": "INFO",
  "country_filter": null,
  "stats_file": null,
  "harvest_sources": [],
  "no_reuse_seconds": 2700,
  "enable_warpplus": false,
  "warpplus_instances": 4,
  "warpplus_mode": "auto",
  "enable_v2ray": false,
  "v2ray_max_nodes": 240
