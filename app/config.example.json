{
  "_comment": "ip-rotator v2.1 config. Copy to config.json and edit; every key is optional (defaults in ip_rotator/config.py). Load with: uv run ip-rotator serve --config config.json. Full field docs: docs/07-config.md",
  "listen_host": "127.0.0.1",
  "listen_port": 8000,
  "enable_socks": true,
  "socks_listen_host": "127.0.0.1",
  "socks_listen_port": 1080,
  "socks_username": "",
  "socks_password": "",
  "socks_handshake_timeout": 10.0,
  "interval": 10.0,
  "rotate_every_request": false,
