  "recycle_avoid_seconds": 600.0,
  "sticky_sessions": false,
  "sticky_ttl": 60.0,
  "starvation_wait": 5.0,
  "starvation_retry_delay": 0.5,
  "min_pool": 20,
  "starvation": 5,
  "validation_timeout": 6.0,
  "validation_workers": 64,
  "validated_pool_cap": 600,
  "revalidate_after": 90.0,
  "max_latency_ms": 6000,
  "connect_timeout": 6.0,
  "harvest_interval": 240.0,
  "source_cache_ttl": 240.0,
  "source_backoff_max": 1800.0,
  "max_retries": 2,
  "max_tunnels": 256,
  "idle_timeout": 90.0,
  "max_tunnel_lifetime": 1800.0,
  "fail_threshold": 3,
  "blacklist_minutes": 15.0,
  "allow_plain_http": false,
  "allow_private_targets": false,
  "allowed_connect_ports": [
    443,
    8443,
    2053,
    2083,
    2087,
    2096
  ],
  "enable_warp": true,
  "warp_proxy_port": 40000,
  "warp_reregister_cooldown": 120.0,
  "enable_psiphon": false,
  "psiphon_socks_port": 1080,
  "psiphon_http_port": 8080,
  "enable_vpngate": false,
  "enable_windscribe_proxy": false,
  "windscribe_proxy_socks_port": 1080,
  "windscribe_proxy_locations": [
    "US",
    "CA",
    "UK",
    "FR",
    "DE",
    "NL",
    "NO",
    "CH",
    "RO",
    "TR"
  ],
  "warp_accounts": 0,
  "wireproxy_bin": "/usr/local/bin/wireproxy",
  "wg_socks_base_port": 42000,
  "wg_socks_username": "",
  "wg_socks_password": "",
  "wg_configs_dir": "",
